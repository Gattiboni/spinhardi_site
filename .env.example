# =============================================================================
# Spinhardi Site - Variaveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha as variaveis conforme a fase.
# .env.local nunca eh commitado (coberto pelo .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# FASE 1 - Fundacao local
# -----------------------------------------------------------------------------

# Supabase (banco de dados)
# Painel: https://supabase.com/dashboard/project/grjkqljucszoaujmhgpi
NEXT_PUBLIC_SUPABASE_URL=https://grjkqljucszoaujmhgpi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave server-side (NUNCA expor no frontend, NUNCA commitar)
# Obter em: Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# FASE 3 - Producao
# -----------------------------------------------------------------------------

# Sanity (CMS do blog)
# Painel: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token de LEITURA (opcional hoje: o dataset production e publico). Reservado.
SANITY_API_TOKEN=
# Token de ESCRITA (server-only, NUNCA expor/commitar). Usado pelo write client
# do back-office pra criar/atualizar/publicar posts direto pelo /admin/blog.
# Obter em: sanity.io/manage > API > Tokens > "Editor" (permissao de escrita).
SANITY_API_WRITE_TOKEN=

# Resend (e-mail transacional do formulario)
# Painel: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=contato@spinharditurismo.com.br

# Anthropic (camada de IA)
# Painel: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# FASE 4 - Pos-launch / Integracoes
# -----------------------------------------------------------------------------

# IDAS (sistema de reservas)
IDAS_API_URL=
IDAS_API_KEY=

# ClickMassa (CRM / WhatsApp)
CLICKMASSA_API_URL=
CLICKMASSA_API_KEY=

# ─── ClickMassa - Lote G (sync de leads) ─────────────────────────────────
# Telefone de teste para smoke test G.2 (formato: 5519XXXXXXXXX, sem +)
CLICKMASSA_TEST_NUMBER=
# ID numerico do agente padrao para opps criadas via site (ex: 164 = Amanda)
CLICKMASSA_DEFAULT_AGENT_ID=

# Make (automacoes - webhook de bridge IDAS <-> ClickMassa)
MAKE_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# LOTE E - Back office (auth real + aprovacao manual)
# -----------------------------------------------------------------------------

# Chave publica para @supabase/ssr (auth real do back office).
# OPCIONAL: se vazia, o codigo usa NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY como fallback.
# Obter em: Settings > API > "anon public" / "Publishable key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo HMAC dos tokens de aprovacao. Gerar com: openssl rand -hex 32
APPROVAL_HMAC_SECRET=

# E-mail que recebe as notificacoes de "nova solicitacao de acesso"
APPROVAL_NOTIFICATION_EMAIL=alangattiboni@gmail.com

# URL base usada nos links de aprovacao do e-mail (opcional).
# Default no codigo: https://www.spinharditurismo.com.br
NEXT_PUBLIC_SITE_URL=https://www.spinharditurismo.com.br


# -----------------------------------------------------------------------------
# LOTE F - Webhook de revalidacao on-publish (Sanity -> Vercel)
# -----------------------------------------------------------------------------

# Segredo HMAC do webhook /api/revalidate. Mesmo valor configurado no painel
# da Sanity (Webhooks > Secret). Gerar com: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# LOTE CAMP - Campanhas de e-mail marketing
# -----------------------------------------------------------------------------

# E-mail que recebe as notificacoes do formulario do site. JA EXISTE em producao
# e estava faltando aqui (achado do lote CAMP). Usado tambem como reply-to
# forcado, pela decisao anti-forwarding D033.
RESEND_TO_EMAIL=

# ATENCAO: a chave em producao hoje e RESTRITA A ENVIO ("sending access"), o que
# faz Contacts / Segments / Broadcasts responderem 401 restricted_api_key.
# Campanha precisa de uma chave FULL ACCESS.
# Painel: https://resend.com/api-keys
# (RESEND_API_KEY e RESEND_FROM_EMAIL ja estao declaradas la em cima, na Fase 3.)

# Segredo de assinatura do webhook de eventos do Resend.
# Painel: Resend > Webhooks > (seu webhook) > "Signing Secret". Formato whsec_...
# Endpoint a cadastrar: https://www.spinharditurismo.com.br/api/webhooks/resend
# Eventos a marcar: email.sent, email.scheduled, email.delivered,
#   email.delivery_delayed, email.bounced, email.complained, email.opened,
#   email.clicked, email.failed, email.suppressed, contact.updated
#   (contact.updated e o que carrega o descadastro — sem ele a supressao
#    automatica de unsubscribe nao acontece.)
RESEND_WEBHOOK_SECRET=

# Segment reservado do publico "todos os elegiveis". OPCIONAL: se vazia, o
# codigo cria o segmento no primeiro envio e GRITA o id no log pra voce colar
# aqui. Sem a env, cada ambiente novo criaria um segmento diferente.
RESEND_SEGMENT_TODOS_ELEGIVEIS_ID=

# MODO SEGURO. "1" (default, inclusive se a env nao existir) = o pipeline resolve
# o publico real, LOGA as contagens, e substitui os destinatarios pela lista de
# teste abaixo. NENHUM contato real recebe nada. "0" liga o disparo de verdade.
CAMPANHAS_MODO_SEGURO=1

# Lista de teste do MODO SEGURO, separada por virgula. Os enderecos de teste do
# proprio Resend ja entram sozinhos (delivered@resend.dev e bounced@resend.dev)
# e provam entrega, retorno e o ciclo de webhook inteiro. Acrescente aqui um
# e-mail real seu se quiser ver o e-mail chegando na caixa.
CAMPANHAS_EMAILS_TESTE=

# Endereco fisico que aparece no rodape travado de toda campanha. O repo so
# conhece "Serra Negra, SP" — ponha aqui o endereco completo da agencia.
# Default no codigo: "Spinhardi Turismo · Serra Negra, SP · Brasil"
CAMPANHAS_ENDERECO_RODAPE=
